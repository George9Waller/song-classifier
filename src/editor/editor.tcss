/* ─────────────────── card grid ─────────────────── */
.card-grid {
    layout: grid;
    grid-size: 4;
    grid-gutter: 1 2;
    height: auto;
    padding: 1;
}

/* ─────────────────── card base ─────────────────── */
.card {
    height: 9;
    border: solid $surface-darken-1;
    padding: 1;
    background: $surface;
}

.card:hover {
    background: $surface-lighten-1;
    border: solid $accent;
}

.card-avatar {
    text-align: center;
    width: 100%;
    height: 3;
    text-style: bold;
    content-align: center middle;
}

.card-name {
    text-align: center;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-subtitle {
    text-align: center;
    width: 100%;
    color: $text-muted;
    overflow: hidden;
}

/* ─────────────────── sort bar ─────────────────── */
.sort-bar {
    height: 3;
    align: left middle;
    padding: 0 1;
    background: $panel;
}

.sort-bar Label {
    margin: 0 1;
    color: $text-muted;
}

.sort-bar Button {
    min-width: 8;
}

/* ─────────────────── search ─────────────────── */
.search-container {
    height: auto;
    padding: 0 1;
}

#search-input {
    width: 100%;
}

SearchResultsPanel {
    background: $surface;
    border: solid $primary;
    height: auto;
    max-height: 24;
    margin: 0 1;
    padding: 1;
    overflow-y: auto;
}

.search-section-title {
    text-style: bold;
    color: $primary;
    margin-top: 1;
}

.search-result-item {
    padding: 0 2;
    height: 1;
    width: 100%;
}

.search-result-item:hover {
    background: $surface-lighten-1;
    color: $accent;
}

/* ─────────────────── detail screens ─────────────────── */
.detail-header {
    height: 3;
    align: left middle;
    padding: 0 1;
    background: $panel;
}

.detail-title {
    padding: 0 2;
    text-style: bold;
    width: 1fr;
}

.section-title {
    text-style: bold;
    padding: 1 1 0 1;
    color: $primary;
}

/* ─────────────────── edit modal ─────────────────── */
TrackEditModal {
    align: center middle;
}

TrackEditModal > Container {
    width: 64;
    height: auto;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
    color: $accent;
}

TrackEditModal Label {
    margin-top: 1;
    color: $text-muted;
}

TrackEditModal Input {
    width: 100%;
}

.modal-buttons {
    align: center middle;
    margin-top: 1;
    height: 3;
}

.modal-buttons Button {
    margin: 0 1;
}
